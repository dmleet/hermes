# Copy to .env for local runs. In Kubernetes these come from Secret/hermes.
HERMES_CONFIG_PATH=config.yaml
HERMES_DATA_DIR=data
HERMES_PORT=8000

# This file is gitignored and never opened by development tooling: secrets live here too.
# LISTENBRAINZ_TOKEN is optional: public playlists need none; it only adds private ones.
LISTENBRAINZ_TOKEN=
# Compose Prowlarr as seen from the host (the hermes container overrides the URL to
# http://prowlarr:9696). scripts/dev-init.sh generates the key and writes it here.
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
# Set to false to let the compose Hermes grab from PandaCD (policy dry_run is overridden).
HERMES_DRY_RUN=true
# Deluge instance URLs live in config.yaml (deluge.instances); the Web UI password is shared.
DELUGE_PASSWORD=
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
MUSICBRAINZ_CONTACT=you@example.com
